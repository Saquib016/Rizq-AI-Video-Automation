# =====================================================================
#  CINEFORGE SETTINGS
#  You can edit everything on the website: Settings page (no restart needed).
#  This file is only for people who prefer editing by hand. Copy it to ".env".
#  Rules: no spaces around "=", no quotes. Restart "python run.py" after hand edits.
# =====================================================================

# ---------------------------------------------------------------------
#  1. AI WRITERS: tried in this order until one answers (comma separated)
#     Options: gemini, anthropic, openai, xai, groq, openrouter, deepseek, mistral, custom
# ---------------------------------------------------------------------
# Free ones first, Claude last as a paid backup. A provider without a key AND model is skipped automatically.
LLM_PROVIDERS=gemini,groq,openrouter,anthropic

# Gemini (Google): free tier. Key: aistudio.google.com
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
GEMINI_FALLBACK_MODELS=
GEMINI_TIMEOUT=600
GEMINI_DAILY_LIMIT=0

# Claude (Anthropic): paid
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
ANTHROPIC_VISION_MODEL=claude-haiku-5-5

# ChatGPT (OpenAI): paid. This key is also used for ChatGPT voices and AI posters.
OPENAI_API_KEY=
OPENAI_MODEL=

# Grok (xAI): paid
XAI_API_KEY=
XAI_MODEL=

# Groq: free tier available
GROQ_API_KEY=
GROQ_MODEL=

# OpenRouter: some free models (names end in :free)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# DeepSeek and Mistral
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=
MISTRAL_API_KEY=
MISTRAL_MODEL=

# Custom: any service with an OpenAI-style API
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_MODEL=
# (Model names change often. On the Settings page press "Load models" to see what your key can use.)

# ---------------------------------------------------------------------
#  2. VOICE
# ---------------------------------------------------------------------
# edge = free Microsoft voices | elevenlabs = best emotion | openai = ChatGPT voices
VOICE_PROVIDER=edge
EDGE_VOICE=en-US-AndrewNeural
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_v4
ELEVENLABS_STABILITY=0.5
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=alloy
# 1 = if paid voice credits run out, redo the video with the free voice
VOICE_FALLBACK=1

# ---------------------------------------------------------------------
#  2b. PICTURE QUALITY AND THE HOOK
# ---------------------------------------------------------------------
# 1080p | 1440p | 4k. Clips are cut at 1080p; the finished video is upsized once at the end.
OUTPUT_RES_SHORT=4k
OUTPUT_RES_LONG=1440p
# Use the graphics card's encoder when it works (much faster 4K), else the CPU
HW_ENCODE=1
# The first seconds use the strongest trailer scenes, cut fast
HOOK_ENABLED=1
HOOK_SECONDS=4.5
# auto (follows the video's mood) | balanced | comedy | romance | action | shock | emotional (nudity and explicit scenes are always skipped)
HOOK_STYLE=auto
# 1 = fewer AI requests per video (recommended on free plans)
BUDGET_MODE=1
# 1 = extra AI request to rank posters (off: ideas already come with a click prediction)
RANK_THUMBNAILS=0

# ---------------------------------------------------------------------
#  3. FOOTAGE AND POSTERS
# ---------------------------------------------------------------------
PIXABAY_API_KEY=
PEXELS_API_KEY=
TMDB_API_KEY=
DESCRIBE_TRAILER_SCENES=1
PREFER_VERTICAL_TRAILERS=1
SHORT_PAN=1
SHORT_FILL=0.8
# 0 = no posters (thumbnails) for Shorts: faster
SHORT_THUMBNAILS=0
OPENAI_IMAGE_MODEL=gpt-image-1

# ---------------------------------------------------------------------
#  4. VIDEO LENGTH (about 2.5 spoken words per second)
# ---------------------------------------------------------------------
SHORT_TARGET_WORDS=62
SHORT_MAX_WORDS=70
# Parts in a Short: 5 = hook, 3 movies, outro
SHORT_SEGMENTS=5
# One-movie Shorts (about 20 s)
SINGLE_TARGET_WORDS=44
SINGLE_MAX_WORDS=50
SINGLE_SEGMENTS=3
LONG_TARGET_WORDS=360
LONG_MAX_WORDS=420
LONG_SEGMENTS=12 to 16

# ---------------------------------------------------------------------
#  5. AUDIO MIX
# ---------------------------------------------------------------------
MUSIC_VOLUME=0.15
VOICE_LUFS=-15

# ---------------------------------------------------------------------
#  6. OTHER
# ---------------------------------------------------------------------
YOUTUBE_DAILY_UPLOADS=6
WORKER_THREADS=1
USE_EMBEDDINGS=0
FONT_PATH=
ALLOW_SILENT_DRYRUN=1

# ---------------------------------------------------------------------
#  7. PUBLISHING TO INSTAGRAM AND FACEBOOK (YouTube uses client_secret.json)
# ---------------------------------------------------------------------
# A Page access token from Meta for Developers, the Facebook Page ID and the Instagram professional account ID (see README)
META_ACCESS_TOKEN=
FB_PAGE_ID=
IG_USER_ID=
META_GRAPH_VERSION=v25.0

# ---------------------------------------------------------------------
#  8. HOOK, TIME LIMITS AND SOURCE QUALITY
# ---------------------------------------------------------------------
# A short bass hit on the first frame
HOOK_SFX=1
# Look at what is already popular on the topic before writing the hook
TREND_RESEARCH=1
# Hard limits: if the voice runs longer, it is sped up (at most 1.2x) to finish in time
SHORT_MAX_SECONDS=30
SINGLE_MAX_SECONDS=20
LONG_MAX_SECONDS=180
# Best trailer quality to download: 1080 | 1440 | 2160 (4K when the trailer has it)
TRAILER_MAX_HEIGHT=2160
# 1080p = fast. match = cut clips at the final size (sharper with 4K trailers, but slower)
CLIP_RES=1080p
# Voice used when the narrator is a female main character (free voices only)
EDGE_VOICE_FEMALE=en-US-AriaNeural

# Background music: auto = your tracks in assets/music/<mood>/, else free no-attribution tracks downloaded once, else generated
MUSIC_SOURCE=auto

# Upload defaults (which boxes are ticked in the Publish box, and YouTube privacy)
PUBLISH_YOUTUBE=1
PUBLISH_INSTAGRAM=1
PUBLISH_FACEBOOK=1
YT_PRIVACY=private
# One-movie long videos: add the studio's official clips (featurettes, teasers, licensed clip channels) to the trailer
OFFICIAL_CLIPS=1

# Shorts: also add 1 official clip per movie (more scenes, slower, more AI requests)
OFFICIAL_CLIPS_SHORTS=0
# Seconds per cut (shorter = faster cutting)
SHORT_SHOT_SECONDS=2.4
LONG_SHOT_SECONDS=4
